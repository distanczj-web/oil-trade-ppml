. 
. capture program drop oil_sparse_ppml

. program define oil_sparse_ppml,eclass
  1.     version 17
  2.     syntax , TREND(integer) [MAXIter(integer 120)]
  3.     tempvar sample
  4.     tempfile iterfile
  5.     gen byte `sample'=1
  6.     mata: oil_fit(`trend',`maxiter',st_local("iterfile"))
  7.     copy "`iterfile'" "iterations.csv",replace
  8.     matrix colnames op_B=meanpd5_post pri5_post trendpd5_post distance_pos
> t2022
  9.     matrix colnames op_V=meanpd5_post pri5_post trendpd5_post distance_pos
> t2022
 10.     matrix rownames op_V=meanpd5_post pri5_post trendpd5_post distance_pos
> t2022
 11.     ereturn post op_B op_V,esample(`sample') obs(`=scalar(op_N)')
 12.     ereturn scalar converged=scalar(op_converged)
 13.     ereturn scalar N_clust=scalar(op_pairs)
 14.     ereturn scalar ic=scalar(op_iterations)
 15.     ereturn scalar score_relative=scalar(op_score)
 16.     ereturn scalar local_margin_relative_error=scalar(op_local_margin_erro
> r)
 17.     ereturn scalar FE_orthogonality=scalar(op_orth)
 18.     ereturn scalar slope_orthogonality=scalar(op_slope_orth)
 19.     ereturn local cmd "oil_sparse_ppml"
 20.     ereturn local title "Independent Stata/Mata PPML numerical verificatio
> n"
 21.     ereturn local vce "cluster"
 22.     ereturn local clustvar "pair_id"
 23.     ereturn display
 24. end

. 
end of do-file

. tempname h

. postfile `h' str12 model str32 term double b se p N converged using "历史安慰
> 剂/results.dta",replace

. foreach name in PL2015 PL2017 {
  2.     use "历史安慰剂/`name'_input.dta",clear
  3.     isid ex im year
  4.     local expected=_N
  5.     ppmlhdfe tradevalue meanpd5_post pri5_post trendpd5_post distance_post
> 2022, absorb(pair_id ex_year im_year) vce(cluster pair_id) separation(fe simp
> lex) tolerance(1e-10) maxiter(500) use_exact_solver(1) d(__fe)
  6.     assert e(N)==`expected' & e(converged)==1
  7.     gen byte estimation_sample=e(sample)
  8.     assert estimation_sample==1
  9.     estimates save "历史安慰剂/`name'.ster",replace
 10.     predict double fitted,mu
 11.     gen double predictor=ln(fitted)
 12.     save "历史安慰剂/`name'_estimated.dta",replace
 13.     foreach term in meanpd5_post pri5_post trendpd5_post distance_post2022
>  {
 14.         post `h' ("`name'") ("`term'") (_b[`term']) (_se[`term']) (2*norma
> l(-abs(_b[`term']/_se[`term']))) (e(N)) (e(converged))
 15.     }
 16.     test meanpd5_post pri5_post trendpd5_post
 17.     matrix FullV=e(V)
 18.     matrix colnames FullV=meanpd5_post pri5_post trendpd5_post distance_po
> st2022 constant
 19.     preserve
 20.     clear
 21.     svmat double FullV,names(col)
 22.     save "历史安慰剂/`name'_covariance.dta",replace
 23.     restore
 24.     egen long __op_p=group(pair_id)
 25.     egen long __op_e=group(ex_year)
 26.     egen long __op_i=group(im_year)
 27.     gen double op_eta=.
 28.     gen double op_mu=.
 29.     local oldpwd `"`c(pwd)'"'
 30.     capture mkdir "历史安慰剂/`name'_local"
 31.     cd "历史安慰剂/`name'_local"
 32.     oil_sparse_ppml,trend(0) maxiter(150)
 33.     assert e(N)==`expected' & e(converged)==1 & e(local_margin_relative_er
> ror)<1e-8
 34.     estimates save "local.ster",replace
 35.     foreach term in meanpd5_post pri5_post trendpd5_post distance_post2022
>  {
 36.         post `h' ("`name'_local") ("`term'") (_b[`term']) (_se[`term']) (2
> *normal(-abs(_b[`term']/_se[`term']))) (e(N)) (e(converged))
 37.     }
 38.     save "validated_predictions.dta",replace
 39.     matrix LocalV=e(V)
 40.     clear
 41.     svmat double LocalV,names(col)
 42.     save "covariance.dta",replace
 43.     cd `"`oldpwd'"'
 44. }
