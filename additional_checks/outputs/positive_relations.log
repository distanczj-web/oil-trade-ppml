. capture program drop oil_sparse_ppml

. program define oil_sparse_ppml,eclass
  1.     version 17
  2.     syntax , TREND(integer) [MAXIter(integer 120)]
  3.     tempvar sample
  4.     tempfile iterfile
  5.     gen byte `sample'=1
  6.     mata: oil_fit(`trend',`maxiter',st_local("iterfile"))
  7.     copy "`iterfile'" "iterations.csv",replace
  8.     matrix colnames op_B=meanpd5_post pri5_post trendpd5_post distance_pos
> t2022 dependence_post trend_dependence_post
  9.     matrix colnames op_V=meanpd5_post pri5_post trendpd5_post distance_pos
> t2022 dependence_post trend_dependence_post
 10.     matrix rownames op_V=meanpd5_post pri5_post trendpd5_post distance_pos
> t2022 dependence_post trend_dependence_post
 11.     ereturn post op_B op_V,esample(`sample') obs(`=scalar(op_N)')
 12.     ereturn scalar converged=scalar(op_converged)
 13.     ereturn scalar N_clust=scalar(op_pairs)
 14.     ereturn scalar ic=scalar(op_iterations)
 15.     ereturn scalar score_relative=scalar(op_score)
 16.     ereturn scalar local_margin_relative_error=scalar(op_local_margin_erro
> r)
 17.     ereturn scalar FE_orthogonality=scalar(op_orth)
 18.     ereturn scalar slope_orthogonality=scalar(op_slope_orth)
 19.     ereturn local cmd "oil_sparse_ppml"
 20.     ereturn local title "Independent Stata/Mata PPML numerical verificatio
> n"
 21.     ereturn local vce "cluster"
 22.     ereturn local clustvar "pair_id"
 23.     ereturn display
 24. end

. 
