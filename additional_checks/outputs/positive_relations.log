> :/(S.xs')))
>         printf("MATA_ITER %g obj=%21.13g alpha=%g score=%g beta_step=%g CG=%g
>  mineta=%g btrend=%g\n",it,newval,alpha,err,db,S.last_iter,min(eta),beta[3]/S
> .xs[3])
>         localerr=max(abs(S.gs(y-exp(eta),1)):/margin_p \ abs(S.gs(y-exp(eta),
> 2)):/margin_e \ abs(S.gs(y-exp(eta),3)):/margin_i)
>         printf("LOCAL_MARGIN_ERROR %g\n",localerr)
>         fput(f,invtokens(strofreal((it,newval,alpha,err,db,S.last_iter,S.last
> _error,min(eta),max(eta),localerr),"%24.16g"),","))
>         if (err<1e-9 & db<1e-6 & abs(old-newval)/S.total<1e-10 & localerr<1e-
> 8) {
>             converged=1
>             break
>         }
>     }
>     fclose(f)
>     st_numscalar("op_local_margin_error",localerr)
>     st_numscalar("op_converged",converged)
>     if (!converged) _error(430)
>     mu=exp(eta);assert(!hasmissing(eta));assert(all(select(mu,y:>0):>0))
>     S.withx=0;S.weights(mu);xr=J(S.n,6,.)
>     for (j=1;j<=6;j++) {
>         c=S.solve_score(mu:*S.x[,j],2e-12)
