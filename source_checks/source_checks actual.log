. 
. capture program drop oil_sparse_ppml

. program define oil_sparse_ppml,eclass
  1.     version 17
  2.     syntax , TREND(integer) [MAXIter(integer 120)]
  3.     tempvar sample
  4.     tempfile iterfile
  5.     gen byte `sample'=1
  6.     mata: oil_fit(`trend',`maxiter',st_local("iterfile"))
  7.     copy "`iterfile'" "iterations.csv",replace
  8.     matrix colnames op_B=meanpd5_post pri5_post trendpd5_post distance_post2022
  9.     matrix colnames op_V=meanpd5_post pri5_post trendpd5_post distance_post2022
 10.     matrix rownames op_V=meanpd5_post pri5_post trendpd5_post distance_post2022
 11.     ereturn post op_B op_V,esample(`sample') obs(`=scalar(op_N)')
 12.     ereturn scalar converged=scalar(op_converged)
 13.     ereturn scalar N_clust=scalar(op_pairs)
 14.     ereturn scalar ic=scalar(op_iterations)
 15.     ereturn scalar score_relative=scalar(op_score)
 16.     ereturn scalar local_margin_relative_error=scalar(op_local_margin_error)
 17.     ereturn scalar FE_orthogonality=scalar(op_orth)
 18.     ereturn scalar slope_orthogonality=scalar(op_slope_orth)
 19.     ereturn local cmd "oil_sparse_ppml"
 20.     ereturn local title "Independent Stata/Mata PPML numerical verification"
 21.     ereturn local vce "cluster"
 22.     ereturn local clustvar "pair_id"
 23.     ereturn display
 24. end

. 
end of do-file

. local models "NoConflictZero ReporterCoverage WeightAmount WeightKg"

. 
. foreach model in `models' {
  2.     use "data/`model'.dta",clear
  3.     isid ex im year
  4.     egen long __op_p=group(pair_id)
  5.     egen long __op_e=group(ex_year)
  6.     egen long __op_i=group(im_year)
  7.     gen double op_eta=.
  8.     gen double op_mu=.
  9.     capture mkdir "outputs/`model'"
 10.     cd "outputs/`model'"
 11.     oil_sparse_ppml,trend(0) maxiter(150)
 12.     assert e(N)==_N & e(converged)==1 & e(local_margin_relative_error)<1e-8
 13.     assert e(sample)==1
 14.     estimates save "estimates.ster",replace
 15.     matrix FullV=e(V)
 16.     tempname result
 17.     postfile `result' str32 term double(b se p) long N using "coefficients.dta",replace
 18.     foreach term in meanpd5_post pri5_post trendpd5_post distance_post2022 {
 19.         post `result' ("`term'") (_b[`term']) (_se[`term']) (2*normal(-abs(_b[`term']/_se[`term']))) (e(N))
 20.     }
 21.     postclose `result'
 22.     preserve
 23.     save "analysis_ready.dta",replace
 24.     restore
 25.     clear
 26.     svmat double FullV,names(col)
 27.     save "covariance.dta",replace
 28.     cd `"`project'"'
 29. }
